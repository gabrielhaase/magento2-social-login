$lastname  = $block->escapeHtmlAttr($profile['lastname'] ?? '');
$email     = $block->escapeHtmlAttr($profile['email'] ?? '');
?>

<div class="block block-social-complete-registration">
    <div class="block-title">
        <strong><?= $block->escapeHtml(__('Complete Your Registration')) ?></strong>
    </div>
    <div class="block-content">
        <p class="social-registration-intro">
            <?= $block->escapeHtml(__('We need a few more details to create your account.')) ?>
        </p>

        <form class="form social-complete-registration-form"
              action="<?= $block->escapeUrl($block->getFormAction()) ?>"
              method="post"
              id="social-complete-registration-form">

            <?= $block->getBlockHtml('formkey') ?>

            <fieldset class="fieldset">

                <div class="field field-name-firstname required">
                    <label class="label" for="firstname">
                        <span><?= $block->escapeHtml(__('First Name')) ?></span>
                    </label>
                    <div class="control">
                        <input type="text"
                               id="firstname"
                               name="firstname"
                               value="<?= $firstname ?>"
                               class="input-text"
                               required/>
                    </div>
                </div>

                <div class="field field-name-lastname required">
                    <label class="label" for="lastname">
                        <span><?= $block->escapeHtml(__('Last Name')) ?></span>
                    </label>
                    <div class="control">
                        <input type="text"
                               id="lastname"
                               name="lastname"
                               value="<?= $lastname ?>"
                               class="input-text"
                               required/>
                    </div>
                </div>

                <div class="field field-email">
                    <label class="label" for="email">
                        <span><?= $block->escapeHtml(__('Email')) ?></span>
