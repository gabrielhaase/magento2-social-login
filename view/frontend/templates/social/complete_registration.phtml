                               id="email"
                               name="email_display"
                               value="<?= $email ?>"
                               class="input-text"
                               readonly
                               disabled/>
                    </div>
                </div>

                <div class="field field-taxvat required">
                    <label class="label" for="taxvat">
                        <span><?= $block->escapeHtml(__('CPF')) ?></span>
