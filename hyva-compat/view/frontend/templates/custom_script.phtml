<h2><?= /** @noEscape */ __('Login successful!!!') ?></h2>
<style>
:root body {
    margin: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}
body h2 {
    font-weight: bold;
    margin: 0;
}
</style>
<script>
    setTimeout(function () {
        if (window.opener && !window.opener.closed) {
            // Tell the parent window's Hyva runtime to reload customer section data,
            // then force a full reload so the logged-in state is reflected everywhere.
            window.opener.dispatchEvent(new CustomEvent('reload-customer-section-data'));
            window.opener.location.reload(true);
        }
        window.close();
    }, 1500);
</script>
