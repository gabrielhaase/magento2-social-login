<script>
function cpfMaskForm() {
    return {
        formatCpf(input) {
            let raw = input.value.replace(/\D/g, '').slice(0, 11);
            raw = raw
                .replace(/^(\d{3})(\d)/, '$1.$2')
                .replace(/^(\d{3})\.(\d{3})(\d)/, '$1.$2.$3')
                .replace(/\.(\d{3})(\d)/, '.$1-$2');
            input.value = raw;
        },
        stripCpfMask() {
            // Strip formatting so only digits reach the server; form submits normally after this.
            const taxvat = this.$refs.taxvat;
            if (taxvat) {
                taxvat.value = taxvat.value.replace(/\D/g, '');
            }
        }
    };
}
</script>
