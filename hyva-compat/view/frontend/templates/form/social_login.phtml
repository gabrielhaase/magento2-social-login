/** @var \Techyouknow\SocialLogin\Block\SocialBlock $block */

// Facebook ships its icon as fb-48.png while the provider key is "facebook".
$iconFileMap = ['facebook' => 'fb'];
?>

<?php if ($block->isSocialLoginActive() && count($block->getEnabledSocialNetworks()) > 0): ?>
<div class="block block-social-login">
    <div class="social-login-container"
         x-data="socialLoginOpener()">

        <div class="seperator">
            <strong><?= $block->escapeHtml(__('or')) ?></strong>
        </div>

        <div class="block-content" aria-labelledby="block-customer-login-heading">
            <ul>
                <?php foreach ($block->getEnabledSocialNetworks() as $key => $socialNetwork):
                    $iconFile = $iconFileMap[$key] ?? $key;
                    $iconUrl  = $block->getViewFileUrl(
                        'Techyouknow_SocialLogin::images/social_networks/' . $iconFile . '-48.png'
                    );
                ?>
                <li>
                    <a class="<?= $block->escapeHtmlAttr($key) ?>"
                       href="#"
                       data-provider="<?= $block->escapeHtmlAttr($key) ?>"
                       @click.prevent="openProvider($event.currentTarget.dataset.provider)">
                        <img src="<?= $block->escapeUrl($iconUrl) ?>"
                             alt=""
                             width="20"
                             height="20"
                             aria-hidden="true">
                        <?= $block->escapeHtml(__('Sign In with')) ?>&nbsp;<span><?= $block->escapeHtml($socialNetwork) ?></span>
                    </a>
                </li>
                <?php endforeach; ?>
            </ul>
        </div>
    </div>
</div>

<script>
function socialLoginOpener() {
    return {
        openProvider(provider) {
            const url    = '/techyouknow_redirect/social/login/provider/' + provider;
            const width  = 500;
            const height = 500;
            const left   = Math.round((window.screen.width  - width)  / 2);
            const top    = Math.round((window.screen.height - height) / 2);
            const feat   = `menubar=no,status=no,scrollbars=no,width=${width},height=${height},left=${left},top=${top}`;

            window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
            window.open(url, '', feat);
        }
    };
}
</script>
<?php endif; ?>
